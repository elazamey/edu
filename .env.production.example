# Example only. Never commit a populated .env file or real credentials.
NODE_ENV=production
# Render injects PORT automatically; use 10000 only for local emulation.
PORT=10000

# Optional path for the persistent JSON database file (defaults to data/nexus-db.json).
DATABASE_PATH=data/nexus-db.json

# Secret used to sign HttpOnly session tokens in production (minimum 32 characters).
SESSION_SECRET=
JWT_SECRET=

# Stage 5: Free-Only AI Policy (Fail-Closed Zero Spend)
AI_ACCESS_MODE=FREE_ONLY
MAX_SPEND_USD=0
BILLING_ALLOWED=false

# AI Provider Endpoints & Keys (all providers remain disabled until all 5 verification gates pass)
OPENROUTER_API_KEY=
HF_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=
OLLAMA_BASE_URL=

# Optional GitHub OAuth credentials.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
