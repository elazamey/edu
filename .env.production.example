# Example only. Never commit a populated .env file or real credentials.
NODE_ENV=production
# Render injects PORT automatically; use 10000 only for local emulation.
PORT=10000

# Reserved for future database and authentication integrations; unused today.
DATABASE_URL=
SUPABASE_URL=
# Server-only key; never expose this value to browser code.
SUPABASE_SERVICE_ROLE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Public callback URL registered in the GitHub OAuth application.
GITHUB_CALLBACK_URL=https://your-domain.example/api/auth/github/callback
SESSION_COOKIE_NAME=nexus_session
