# Example only. Never commit a populated .env file or real credentials.
NODE_ENV=production
# Render injects PORT automatically; use 10000 only for local emulation.
PORT=10000

# LLM provider for agent execution. One of: openai, xai, openai-compatible.
LLM_PROVIDER=openai
# Required: provider API key and model name.
LLM_API_KEY=
LLM_MODEL=
# Base URL override. Required for openai-compatible; defaults are applied
# for openai (https://api.openai.com/v1) and xai (https://api.x.ai/v1).
LLM_BASE_URL=
# Optional request tuning.
LLM_TIMEOUT_MS=60000
LLM_TEMPERATURE=
LLM_MAX_TOKENS=

# SQLite database file. Defaults to <repo>/data/nexus.sqlite; use :memory:
# for an ephemeral database.
DATABASE_PATH=

# Reserved for future integrations; unused today.
SUPABASE_URL=
SUPABASE_ANON_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
JWT_SECRET=
